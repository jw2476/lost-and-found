{
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "files.exclude": {
        ".venv/**/*": true,
        "**/__pycache__/": true,
        "**/*.py[oc]": true,
        "**/build/": true,
        "**/dist/": true,
        "**/wheels/": true,
        "**/*.egg-info": true,
        "**/.venv": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.coverage": true,
        "docs/source/_autosummary": true
    }
}